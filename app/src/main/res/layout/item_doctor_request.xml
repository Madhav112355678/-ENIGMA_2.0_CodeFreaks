<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_auth_logo"
                android:background="#E1F5FE"
                android:padding="8dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvPatientName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Patient Name"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"/>
                
                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date Requested"
                    android:textSize="12sp"
                    android:textColor="#888888"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Action Buttons (Visible only if Pending) -->
        <LinearLayout
            android:id="@+id/llActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:weightSum="2">

            <Button
                android:id="@+id/btnDecline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Decline"
                android:textColor="#F44336"
                android:backgroundTint="#FFEBEE"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnAccept"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Accept"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/green_primary"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Open Chat Button (Visible only if Accepted) -->
        <Button
            android:id="@+id/btnOpenChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open Chat"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/green_primary"
            android:layout_marginTop="16dp"
            android:visibility="gone"/>

        <!-- Message indicating Declined -->
        <TextView
            android:id="@+id/tvDeclinedMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Declined"
            android:textColor="#F44336"
            android:textStyle="italic"
            android:layout_marginTop="16dp"
            android:layout_gravity="center"
            android:visibility="gone"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
